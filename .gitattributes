# 统一换行符为 LF
# Windows 开发环境下，Python 脚本若被转成 CRLF，在 Linux 容器里执行会报
# `/usr/bin/env: 'python3\r': No such file or directory`
* text=auto eol=lf

# 明确声明文本类型
*.md    text
*.py    text
*.json  text
*.yml   text
*.yaml  text
*.sql   text
*.go    text
*.ts    text
*.tsx   text
*.js    text
*.css   text
*.html  text

# 二进制，禁止 diff 与换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.mp3   binary
*.mp4   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tgz   binary
