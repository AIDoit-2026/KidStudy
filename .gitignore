# ============================================================
# KidStudy · .gitignore
#
# 三条原则：
#   1. 采集产物不入库 —— 全部可由 tools/ 下的脚本重新生成，入库只会拖垮仓库
#   2. 密钥与真实数据不入库 —— 只提交 .env.example 这类占位模板
#   3. 构建产物不入库 —— 交给各语言的包管理器处理
# ============================================================

# ------------------------------------------------------------
# 1. 采集产物 / 运行时数据（爬虫下载、解析结果、索引）
# ------------------------------------------------------------
# 全部可由 `python tools/crawl_stories.py` 等脚本重建，体量 260+ MB
# 注意：必须写 var/* 而非 var/ —— 目录被整体排除后，git 不会进入
# 其内部匹配例外规则，!var/README.md 会失效
var/*
!var/README.md

# ------------------------------------------------------------
# 2. 敏感资源 —— 密钥、证书、真实环境配置
# ------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample

# 私钥与证书
*.key
*.pem
*.p12
*.pfx
*.keystore
*.jks
*.crt
*.cer
*.der

# 密钥/凭据目录
secrets/
credentials/
*.credentials.json
service-account*.json

# 数据库文件与备份（可能含真实业务数据）
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sql.gz
*.dump
dumps/
backups/

# ------------------------------------------------------------
# 3. Go 后端
# ------------------------------------------------------------
# 编译产物（务必精确到目录：写成 /server 会把整个后端源码排除掉）
/server/bin/
/server/tmp/
*.exe
*.exe~
*.dll
*.so
*.dylib
# 测试与覆盖率
*.test
*.out
coverage.txt
coverage.html

# ------------------------------------------------------------
# 4. React / Node 前端
# ------------------------------------------------------------
node_modules/
dist/
build/
.vite/
.cache/
.parcel-cache/
coverage/
*.tsbuildinfo
# 自定义 npm cache 目录（本机用 --cache 指到 web/.npm-cache，避免污染全局）
.npm-cache/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------
# 5. Python（采集与分析脚本）
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ------------------------------------------------------------
# 6. 日志与临时文件
# ------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# ------------------------------------------------------------
# 7. 编辑器与操作系统
# ------------------------------------------------------------
.idea/
*.iml
.vscode/*
!.vscode/settings.example.json
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# 8. WorkBuddy 工作目录（保留项目记忆，忽略会话与缓存）
# ------------------------------------------------------------
.workbuddy/*
!.workbuddy/memory/

#--------------------
# 外部工具
#--------------------

tools/sqlc
