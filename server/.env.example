# ---------- 服务 ----------
APP_ENV=development
APP_VERSION=dev
HTTP_ADDR=:8080
BASE_URL=http://localhost:8080
TRUSTED_PROXY=false

# ---------- 日志（json | text；debug | info | warn | error） ----------
LOG_LEVEL=info
LOG_FORMAT=text

# ---------- 数据库 ----------
DATABASE_URL=postgres://kidstudy:kidstudy@localhost:5432/kidstudy?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# ---------- CORS（生产禁用通配符，多个来源用逗号分隔） ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- 限流（M7）----------
# 按客户端 IP 分桶，三类敏感端点各一档；关闭后全部直通（本地压测可设 false）。
#   *_PER_MIN 每分钟补充的令牌数；*_BURST 允许的瞬时突发（桶容量）。
# 登录档也覆盖 /auth/register 与 /auth/pin/verify（PIN 只有 4 位，同属可枚举凭据）。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MIN=12
RATE_LIMIT_LOGIN_BURST=6
RATE_LIMIT_QR_PER_MIN=120
RATE_LIMIT_QR_BURST=40
RATE_LIMIT_PRINT_PER_MIN=30
RATE_LIMIT_PRINT_BURST=10

# ---------- HTTP 超时与优雅停机 ----------
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s

# ---------- 认证（关闭公开注册：仅凭邀请码建号） ----------
BOOTSTRAP_INVITE_CODE=change-me-before-first-use

# AUTH_SECRET 用于签发 Access / Unlock 令牌，至少 32 字符。
# 生成：openssl rand -base64 48
AUTH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
UNLOCK_TOKEN_TTL=5m
QR_CODE_TTL=60s
EXCHANGE_CODE_TTL=30s

# 刷新令牌 Cookie 是否带 Secure。留空/不设 = 随环境（生产 true、其余 false）。
# 显式设置用于「生产域名走 HTTPS 但本机 http 反代调试」这类场景；生产环境置 false 会被配置校验拦下。
# COOKIE_SECURE=true

# ---------- 冒烟脚本（server/tests/smoke）与 UI 验收（server/tests/ui）用的测试账号 ----------
# 只在本机跑测试时用得上，填什么都行；这些值不会被写进仓库。
#   SMOKE_PASSWORD：smoke_m2..m6 用它**新建**临时家长账号（可任意自拟）。
#   SMOKE_ACCOUNT / SMOKE_PIN：probe_types.py 与 tests/ui/* 用它登录一个**已存在**的家长账号，
#     该账号由 server/tests/ui/ui_setup.py 造出来，PIN 是 ui_setup.py 设的那个。
SMOKE_ACCOUNT=smoke@example.com
SMOKE_PASSWORD=change-me-local-only
SMOKE_PIN=2468

# 可选：后端 API 地址（tests/ui/ui_setup.py 用），不填则用下面的默认值。
# API_BASE_URL=http://127.0.0.1:18080/api/v1
