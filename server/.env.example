# ---------- 服务 ----------
APP_ENV=development
APP_VERSION=dev
HTTP_ADDR=:8080
BASE_URL=http://localhost:8080
TRUSTED_PROXY=false

# ---------- 日志（json | text；debug | info | warn | error） ----------
LOG_LEVEL=info
LOG_FORMAT=text

# ---------- 数据库 ----------
DATABASE_URL=postgres://kidstudy:kidstudy@localhost:5432/kidstudy?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# ---------- CORS（生产禁用通配符，多个来源用逗号分隔） ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- HTTP 超时与优雅停机 ----------
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s

# ---------- 认证（关闭公开注册：仅凭邀请码建号） ----------
BOOTSTRAP_INVITE_CODE=
