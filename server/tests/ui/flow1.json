[
  ["open", "${BASE_URL}/login"],
  ["wait", "1500"],
  ["snapshot", "-i"],
  ["fill", "input[placeholder=\"parent@example.com\"]", "${SMOKE_ACCOUNT}"],
  ["fill", "input[type=\"password\"]", "${SMOKE_PASSWORD}"],
  ["click", "button[type=\"submit\"]"],
  ["wait", "2500"],
  ["snapshot"],
  ["screenshot", "${OUT_DIR}/01-select-child.png"],
  ["eval", "JSON.stringify({url:location.pathname, text:document.body.innerText.slice(0,300)})"],
  ["find", "text", "哥哥", "click"],
  ["wait", "1200"],
  ["fill", "input[inputmode=\"numeric\"]", "${SMOKE_PIN}"],
  ["eval", "(()=>{const d=document.querySelector('[role=\"dialog\"]'); if(!d) return 'no-dialog'; const b=[...d.querySelectorAll('button')].find(x=>x.textContent.trim()==='解锁'); if(!b) return 'no-unlock'; b.click(); return 'clicked-unlock';})()"],
  ["wait", "3000"],
  ["snapshot"],
  ["screenshot", "${OUT_DIR}/02-home.png"],
  ["eval", "JSON.stringify({url:location.pathname, text:document.body.innerText.slice(0,400), buttons:[...document.querySelectorAll('button')].map(b=>b.textContent.trim())})"],
  ["set", "viewport", "390", "844"],
  ["wait", "800"],
  ["screenshot", "${OUT_DIR}/03-phone.png"],
  ["set", "viewport", "820", "1180"],
  ["wait", "800"],
  ["screenshot", "${OUT_DIR}/04-tablet.png"],
  ["set", "viewport", "1440", "900"],
  ["wait", "800"],
  ["screenshot", "${OUT_DIR}/05-desktop.png"],
  ["set", "viewport", "1920", "1080"],
  ["wait", "800"],
  ["screenshot", "${OUT_DIR}/06-big.png"],
  ["eval", "JSON.stringify({sm:window.matchMedia('(min-width:640px)').matches,md:window.matchMedia('(min-width:768px)').matches,lg:window.matchMedia('(min-width:1024px)').matches,xl:window.matchMedia('(min-width:1600px)').matches,inner:[window.innerWidth,window.innerHeight],rootFont:getComputedStyle(document.documentElement).fontSize,theme:document.documentElement.getAttribute('data-theme'),kidTop:document.querySelector('header')?.innerText.slice(0,80)})"],
  ["eval", "(()=>{const b=[...document.querySelectorAll('button')].find(x=>x.textContent.trim()==='语文'); if(!b) return 'no-cn-btn'; b.click(); return 'clicked-chinese';})()"],
  ["wait", "3000"],
  ["snapshot"],
  ["screenshot", "${OUT_DIR}/07-practice.png"],
  ["eval", "JSON.stringify({url:location.pathname, active:[...document.querySelectorAll('.is-active')].map(e=>e.textContent.trim().slice(0,24)), optCount:document.querySelectorAll('.is-active').length, body:document.body.innerText.slice(0,300)})"],
  ["press", "ArrowDown"],
  ["wait", "400"],
  ["eval", "JSON.stringify({active:[...document.querySelectorAll('.is-active')].map(e=>e.textContent.trim().slice(0,24))})"],
  ["press", "ArrowDown"],
  ["wait", "400"],
  ["eval", "JSON.stringify({active:[...document.querySelectorAll('.is-active')].map(e=>e.textContent.trim().slice(0,24))})"],
  ["press", "ArrowUp"],
  ["wait", "400"],
  ["eval", "JSON.stringify({active:[...document.querySelectorAll('.is-active')].map(e=>e.textContent.trim().slice(0,24))})"],
  ["screenshot", "${OUT_DIR}/08-keyboard-active.png"],
  ["press", "Enter"],
  ["wait", "3000"],
  ["eval", "JSON.stringify({url:location.pathname, active:[...document.querySelectorAll('.is-active')].map(e=>e.textContent.trim().slice(0,24)), body:document.body.innerText.slice(0,400)})"],
  ["screenshot", "${OUT_DIR}/09-after-enter.png"],
  ["errors"]
]
