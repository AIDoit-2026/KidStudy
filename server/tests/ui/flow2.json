[
  ["open", "${BASE_URL}/login"],
  ["wait", "1500"],
  ["fill", "input[placeholder=\"parent@example.com\"]", "${SMOKE_ACCOUNT}"],
  ["fill", "input[type=\"password\"]", "${SMOKE_PASSWORD}"],
  ["click", "button[type=\"submit\"]"],
  ["wait", "2500"],
  ["eval", "JSON.stringify({url:location.pathname, theme:document.documentElement.getAttribute('data-theme')})"],
  ["find", "text", "哥哥", "click"],
  ["wait", "900"],
  ["snapshot"],
  ["fill", "input[inputmode=\"numeric\"]", "${SMOKE_PIN}"],
  ["find", "text", "解锁", "click"],
  ["wait", "3000"],
  ["snapshot"],
  ["eval", "JSON.stringify({url:location.pathname, text:document.body.innerText.slice(0,500), buttons:[...document.querySelectorAll('button')].map(b=>b.textContent.trim()), timeBar:document.querySelector('header')?.innerText.replace(/\\n/g,' | ')})"],
  ["screenshot", "${OUT_DIR}/02-home-dark.png"],
  ["set", "viewport", "390", "844"],
  ["wait", "700"],
  ["eval", "JSON.stringify({w:innerWidth,sm:matchMedia('(min-width:640px)').matches,md:matchMedia('(min-width:768px)').matches,lg:matchMedia('(min-width:1024px)').matches,xl:matchMedia('(min-width:1600px)').matches})"],
  ["screenshot", "${OUT_DIR}/03-phone.png"],
  ["set", "viewport", "820", "1180"],
  ["wait", "700"],
  ["eval", "JSON.stringify({w:innerWidth,sm:matchMedia('(min-width:640px)').matches,md:matchMedia('(min-width:768px)').matches,lg:matchMedia('(min-width:1024px)').matches,xl:matchMedia('(min-width:1600px)').matches})"],
  ["screenshot", "${OUT_DIR}/04-tablet.png"],
  ["set", "viewport", "1440", "900"],
  ["wait", "700"],
  ["eval", "JSON.stringify({w:innerWidth,sm:matchMedia('(min-width:640px)').matches,md:matchMedia('(min-width:768px)').matches,lg:matchMedia('(min-width:1024px)').matches,xl:matchMedia('(min-width:1600px)').matches})"],
  ["screenshot", "${OUT_DIR}/05-desktop.png"],
  ["set", "viewport", "1920", "1080"],
  ["wait", "700"],
  ["eval", "JSON.stringify({w:innerWidth,sm:matchMedia('(min-width:640px)').matches,md:matchMedia('(min-width:768px)').matches,lg:matchMedia('(min-width:1024px)').matches,xl:matchMedia('(min-width:1600px)').matches})"],
  ["screenshot", "${OUT_DIR}/06-big.png"],
  ["errors"]
]
