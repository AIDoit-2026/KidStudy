[
  ["open", "${BASE_URL}/login"],
  ["wait", "1500"],
  ["fill", "input[placeholder=\"parent@example.com\"]", "${SMOKE_ACCOUNT}"],
  ["fill", "input[type=\"password\"]", "${SMOKE_PASSWORD}"],
  ["click", "button[type=\"submit\"]"],
  ["wait", "2500"],
  ["eval", "(()=>{const b=[...document.querySelectorAll('button')].find(x=>x.textContent.includes('哥哥')); if(!b) return 'no-child'; b.click(); return 'clicked-child';})()"],
  ["wait", "1200"],
  ["fill", "input[inputmode=\"numeric\"]", "${SMOKE_PIN}"],
  ["eval", "(()=>{const d=document.querySelector('[role=\"dialog\"]'); if(!d) return 'no-dialog'; const b=[...d.querySelectorAll('button')].find(x=>x.textContent.trim()==='解锁'); if(!b) return 'no-unlock'; b.click(); return 'clicked-unlock';})()"],
  ["wait", "3000"],
  ["eval", "JSON.stringify({url:location.pathname, text:document.body.innerText.slice(0,200)})"],
  ["set", "viewport", "1920", "1080"],
  ["eval", "[...document.querySelectorAll('button')].filter(b=>b.textContent.trim()==='语文').length"],
  ["eval", "(()=>{const b=[...document.querySelectorAll('button')].find(x=>x.textContent.trim()==='语文'); if(!b) return 'no-button'; b.click(); return 'clicked';})()"],
  ["wait", "4000"],
  ["snapshot"],
  ["eval", "JSON.stringify({url:location.pathname+location.search, kindPrompt:document.querySelector('section.card p.text-2xl')?.textContent, optButtons:[...document.querySelectorAll('ul li button')].map(b=>b.textContent.trim()), active:[...document.querySelectorAll('.is-active')].map(e=>e.textContent.trim()), progress:[...document.querySelectorAll('span')].map(s=>s.textContent.trim()).filter(t=>/^\\d+ \\/ \\d+$/.test(t))})"],
  ["screenshot", "${OUT_DIR}/07-practice-big.png"],
  ["press", "ArrowDown"],
  ["wait", "400"],
  ["eval", "JSON.stringify({active:[...document.querySelectorAll('.is-active')].map(e=>e.textContent.trim())})"],
  ["press", "ArrowDown"],
  ["wait", "400"],
  ["eval", "JSON.stringify({active:[...document.querySelectorAll('.is-active')].map(e=>e.textContent.trim())})"],
  ["press", "ArrowUp"],
  ["wait", "400"],
  ["eval", "JSON.stringify({active:[...document.querySelectorAll('.is-active')].map(e=>e.textContent.trim())})"],
  ["screenshot", "${OUT_DIR}/08-keyboard-active.png"],
  ["press", "Enter"],
  ["wait", "4000"],
  ["eval", "JSON.stringify({active:[...document.querySelectorAll('.is-active')].map(e=>e.textContent.trim()), answered:[...document.querySelectorAll('button')].filter(b=>b.disabled).map(b=>b.textContent.trim()), result:document.querySelector('[role=status]')?.innerText, body:document.body.innerText.slice(0,500)})"],
  ["screenshot", "${OUT_DIR}/09-after-enter.png"],
  ["console"],
  ["errors"]
]
