[
  ["open", "${BASE_URL}/login"],
  ["wait", "1500"],
  ["fill", "input[placeholder=\"parent@example.com\"]", "${SMOKE_ACCOUNT}"],
  ["fill", "input[type=\"password\"]", "${SMOKE_PASSWORD}"],
  ["click", "button[type=\"submit\"]"],
  ["wait", "2500"],
  ["eval", "(()=>{const b=[...document.querySelectorAll('button')].find(x=>x.textContent.includes('哥哥')); if(!b) return 'no-child'; b.click(); return 'clicked-child';})()"],
  ["wait", "1200"],
  ["fill", "input[inputmode=\"numeric\"]", "${SMOKE_PIN}"],
  ["eval", "(()=>{const d=document.querySelector('[role=\"dialog\"]'); if(!d) return 'no-dialog'; const b=[...d.querySelectorAll('button')].find(x=>x.textContent.trim()==='解锁'); if(!b) return 'no-unlock'; b.click(); return 'clicked-unlock';})()"],
  ["wait", "3000"],
  ["set", "viewport", "1920", "1080"],
  ["eval", "JSON.stringify({at:location.pathname})"],
  ["eval", "(()=>{const b=[...document.querySelectorAll('button')].find(x=>x.textContent.trim()==='语文'); if(!b) return 'no-cn-btn'; b.click(); return 'clicked-chinese';})()"],
  ["wait", "4500"],
  ["snapshot"],
  ["eval", "JSON.stringify({url:location.pathname+location.search, prompt:document.querySelector('section.card p.text-2xl')?.textContent, options:[...document.querySelectorAll('ul li button')].map(b=>b.textContent.trim()), active:[...document.querySelectorAll('.is-active')].map(e=>e.textContent.trim())})"],
  ["screenshot", "${OUT_DIR}/14-practice-big.png"],
  ["press", "ArrowDown"],
  ["wait", "500"],
  ["eval", "JSON.stringify({active:[...document.querySelectorAll('.is-active')].map(e=>e.textContent.trim())})"],
  ["press", "ArrowDown"],
  ["wait", "500"],
  ["eval", "JSON.stringify({active:[...document.querySelectorAll('.is-active')].map(e=>e.textContent.trim())})"],
  ["press", "ArrowUp"],
  ["wait", "500"],
  ["eval", "JSON.stringify({active:[...document.querySelectorAll('.is-active')].map(e=>e.textContent.trim())})"],
  ["screenshot", "${OUT_DIR}/15-keyboard-active.png"],
  ["press", "Enter"],
  ["wait", "4500"],
  ["eval", "JSON.stringify({verdict:document.querySelector('[role=status]')?.innerText, body:document.body.innerText.replace(/\\n+/g,' | ').slice(0,320)})"],
  ["screenshot", "${OUT_DIR}/16-after-enter.png"],
  ["errors"]
]
