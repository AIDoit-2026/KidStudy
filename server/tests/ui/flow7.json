[
  ["open", "${BASE_URL}/login"],
  ["wait", "1500"],
  ["fill", "input[placeholder=\"parent@example.com\"]", "${SMOKE_ACCOUNT}"],
  ["fill", "input[type=\"password\"]", "${SMOKE_PASSWORD}"],
  ["click", "button[type=\"submit\"]"],
  ["wait", "2500"],
  ["eval", "(()=>{const b=[...document.querySelectorAll('button')].find(x=>x.textContent.includes('哥哥')); if(!b) return 'no-child'; b.click(); return 'clicked-child';})()"],
  ["wait", "1200"],
  ["fill", "input[inputmode=\"numeric\"]", "${SMOKE_PIN}"],
  ["eval", "(()=>{const d=document.querySelector('[role=\"dialog\"]'); if(!d) return 'no-dialog'; const b=[...d.querySelectorAll('button')].find(x=>x.textContent.trim()==='解锁'); if(!b) return 'no-unlock'; b.click(); return 'clicked-unlock';})()"],
  ["wait", "3000"],
  ["set", "viewport", "1920", "1080"],
  ["eval", "(()=>{const b=[...document.querySelectorAll('button')].find(x=>x.textContent.trim()==='知道了'); if(b) b.click(); return b?'dismissed-hint':'no-hint';})()"],
  ["eval", "(()=>{const b=[...document.querySelectorAll('button')].find(x=>x.textContent.trim()==='语文'); if(!b) return 'no-cn-btn'; b.click(); return 'clicked-chinese';})()"],
  ["wait", "4500"],
  ["eval", "JSON.stringify({q1prompt:document.querySelector('section.card p.text-2xl')?.textContent, kind:document.querySelectorAll('ul li button').length, buttons:[...document.querySelectorAll('button')].map(b=>b.textContent.trim())})"],
  ["eval", "(()=>{const b=[...document.querySelectorAll('button')].find(x=>x.textContent.trim()==='做完了'); if(!b) return 'no-subjective-btn'; b.click(); return 'submitted-trace';})()"],
  ["wait", "4000"],
  ["eval", "JSON.stringify({verdict:document.querySelector('[role=status]')?.innerText?.slice(0,60)})"],
  ["eval", "(()=>{const b=[...document.querySelectorAll('button')].find(x=>x.textContent.trim()==='下一题'); if(!b) return 'no-next'; b.click(); return 'clicked-next';})()"],
  ["wait", "4000"],
  ["eval", "JSON.stringify({q2prompt:document.querySelector('section.card p.text-2xl')?.textContent, progress:[...document.querySelectorAll('span')].map(s=>s.textContent.trim()).filter(t=>/^\\d+ \\/ \\d+$/.test(t)), options:[...document.querySelectorAll('ul li button')].map(b=>b.textContent.trim()), active:[...document.querySelectorAll('.is-active')].map(e=>e.textContent.trim())})"],
  ["screenshot", "${OUT_DIR}/17-options-big.png"],
  ["press", "ArrowDown"],
  ["wait", "500"],
  ["eval", "JSON.stringify({active:[...document.querySelectorAll('.is-active')].map(e=>e.textContent.trim())})"],
  ["press", "ArrowDown"],
  ["wait", "500"],
  ["eval", "JSON.stringify({active:[...document.querySelectorAll('.is-active')].map(e=>e.textContent.trim())})"],
  ["press", "ArrowDown"],
  ["wait", "500"],
  ["eval", "JSON.stringify({active:[...document.querySelectorAll('.is-active')].map(e=>e.textContent.trim())})"],
  ["press", "ArrowUp"],
  ["wait", "500"],
  ["eval", "JSON.stringify({activeAfterUp:[...document.querySelectorAll('.is-active')].map(e=>e.textContent.trim())})"],
  ["screenshot", "${OUT_DIR}/18-keyboard-active.png"],
  ["press", "Enter"],
  ["wait", "4500"],
  ["eval", "JSON.stringify({verdict:document.querySelector('[role=status]')?.innerText?.slice(0,80), activeAfterAnswer:[...document.querySelectorAll('.is-active')].map(e=>e.textContent.trim()), body:document.body.innerText.replace(/\\n+/g,' | ').slice(0,300)})"],
  ["screenshot", "${OUT_DIR}/19-after-enter.png"],
  ["errors"]
]
